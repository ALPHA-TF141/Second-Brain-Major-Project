{
  "name": "second-brain",
  "version": "1.0.0",
  "description": "Jarvis OS - Autonomous Personal Cognitive Knowledge Synthesizer.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "backend": "node run_backend.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "lint": "eslint src electron --max-warnings=999",
    "lint:fix": "eslint src electron --fix",
    "check": "npm run lint && npm run check:api && npm run smoke && npm run build",
    "smoke": "node tools/smoke-render.mjs",
    "health:check": "python scripts/health_check.py",
    "smoke:setup": "npm install --no-save playwright && npx playwright install chromium",
    "check:api": "node tools/check-api-contract.mjs",
    "smoke:browser": "node scripts/smoke_test.mjs",
    "verify:backend": "python backend/verify_backend_endpoints.py"
  },
  "build": {
    "appId": "com.secondbrain.jarvis",
    "productName": "Jarvis Second Brain",
    "directories": {
      "output": "dist_installer"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
