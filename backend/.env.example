# ============================================================================
#  JARVIS SECOND BRAIN - backend environment
#  Copy this file to  backend/.env  and fill in your values.
#  backend/.env is git-ignored and is NEVER synced to the memory vault.
# ============================================================================

# --- Google Workspace integration (Gmail + Calendar) ------------------------
# Full walkthrough: GOOGLE_SETUP.md
# Leave these empty and the app shows "Not Connected" - nothing breaks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback

# --- Automatic mail ingestion (Gmail/IMAP -> memory vault) ------------------
# Every interval, new mail is read (read-only), turned into a searchable memory,
# written into the vault + wiki + graph, and scanned for deadlines.
MAIL_SYNC_ENABLED=true
MAIL_SYNC_INTERVAL_MINUTES=10
MAIL_SYNC_FOLDERS=inbox
MAIL_SYNC_LIMIT=25
MAIL_SYNC_SKIP_BULK=true
MAIL_STORE_IN_VAULT=true

# --- Local LLM --------------------------------------------------------------
# Ollama's OpenAI-compatible endpoint. Jarvis auto-detects which model you
# actually have installed, so an exact match here is not critical.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:3b
OPENAI_API_KEY=

# --- Auth -------------------------------------------------------------------
JWT_SECRET_KEY=change-this-dev-secret
